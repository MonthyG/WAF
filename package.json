{
  "name": "cloudinside-waf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "slave",
    "console"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build --workspace slave && npm run build --workspace console",
    "typecheck": "npm run typecheck --workspace slave && npm run typecheck --workspace console",
    "test": "npm run test --workspace slave",
    "dev:api": "npm run dev --workspace slave",
    "db:migrate": "npm run db:migrate --workspace slave",
    "openapi": "npm run openapi --workspace slave",
    "worker": "npm run worker --workspace slave",
    "node:register": "npm run node:register --workspace slave --",
    "dev:console": "npm run dev --workspace console",
    "test:console": "npm run test:e2e --workspace console",
    "ingest": "npm run ingest --workspace slave",
    "meter": "npm run meter --workspace slave --"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
